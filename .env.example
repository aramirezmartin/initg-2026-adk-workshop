# init.g(malaga) 2026 — Google ADK + VirusTotal MCP + Multi-Model Workshop
# Copy to .env (`cp .env.example .env`) and pick ANY model provider you prefer!

# ==============================================================================
# 1. CHOOSE YOUR AGENT MODEL (`ADK_MODEL`) — Pick ONE option below
# ==============================================================================

# --- Option A: Google Gemini (Google AI Studio Free Tier or Vertex AI) ---
ADK_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=your_google_ai_studio_or_vertex_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- Option B: 100% Free Local Open-Source via Ollama (Zero API Key / Zero Quota) ---
# Prerequisite: `ollama serve` & `ollama pull qwen2.5:7b` (or `llama3.2`, `gemma3`)
# ADK_MODEL=ollama_chat/qwen2.5:7b
# OLLAMA_API_BASE=http://localhost:11434

# --- Option C: OpenAI (ChatGPT API) ---
# ADK_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Option D: Anthropic Claude ---
# ADK_MODEL=anthropic/claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=sk-ant-...

# --- Option E: Cloud Open-Source (Groq Free Tier / OpenRouter / DeepSeek / Mistral) ---
# ADK_MODEL=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_...
#
# ADK_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct
# OPENROUTER_API_KEY=sk-or-...

# --- Optional: Mix different models across Coordinator vs Specialist Subagents ---
# COORDINATOR_MODEL=anthropic/claude-sonnet-4-20250514
# SPECIALIST_MODEL=ollama_chat/qwen2.5:7b

# ==============================================================================
# 2. VIRUSTOTAL MCP (`https://ai.virustotal.com/mcp`) — OPTIONAL
# ==============================================================================
# If neither VTAI_AGENT_TOKEN nor VT_API_KEY is set, `vt_intel` automatically
# registers a free VTAI Agent Token on first startup (60 req/min, 1,000/day)
# and saves it privately at ~/.config/vt-mcp/token:
# VTAI_AGENT_TOKEN=vtai_your_token_here
# VT_API_KEY=your_virustotal_or_gti_api_key_here

# ==============================================================================
# 3. NETWORK & RUNTIME OPTIONS
# ==============================================================================
A2A_HOST=localhost
# Set VT_MCP_OFFLINE=true only if classroom Wi-Fi has no internet access
VT_MCP_OFFLINE=false
